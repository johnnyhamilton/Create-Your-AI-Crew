rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Admin email can read and update user metadata docs in the /users collection
      allow read, write: if request.auth != null && (
        request.auth.uid == userId ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'johnny@2itedsol.com')
      );

      // Allow admin to read crew subcollection so admin can compute live crewCount metadata
      match /crew/{crewId} {
        allow read: if request.auth != null && (
          request.auth.uid == userId ||
          (request.auth.token.email != null && request.auth.token.email.lower() == 'johnny@2itedsol.com')
        );
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Other subcollections (foundation, etc.) remain strictly restricted to each user's own uid
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
